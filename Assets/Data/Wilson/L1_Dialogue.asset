%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad24797fc3bb47148bf0e8a956dff761, type: 3}
  m_Name: L1_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Missions.WilsonDialogueSet
  speaker: WILSON
  lines:
  - id: L1_INTRO_01
    trigger: 0
    mood: 0
    textTr: "G\u0131dak! Ben Wilson. Sivritepe'nin en dengesiz evine ho\u015F geldin!"
    cluck: {fileID: 0}
  - id: L1_INTRO_02
    trigger: 0
    mood: 2
    textTr: "Birazdan deprem olacak. Sars\u0131nt\u0131y\u0131 durduramay\u0131z
      ama \xF6nceden \xF6nlem alabiliriz."
    cluck: {fileID: 0}
  - id: L1_TASKS_01
    trigger: 1
    mood: 5
    textTr: "\xD6nce kitapl\u0131\u011F\u0131, sonra buzdolab\u0131n\u0131 g\xFCvenli
      bi\xE7imde sabitle."
    cluck: {fileID: 0}
  - id: L1_TASKS_02
    trigger: 1
    mood: 5
    textTr: "Deprem \xE7antas\u0131n\u0131 kolay eri\u015Filebilecek yere koy. Sonra
      e\u015Fyalar\u0131 dengele!"
    cluck: {fileID: 0}
  - id: L1_READY
    trigger: 2
    mood: 1
    textTr: "D\xF6rt i\u015Fimiz var. Denge g\xF6stergesine dikkat et. Haydi ba\u015Flayal\u0131m!"
    cluck: {fileID: 0}
  - id: L1_TIME
    trigger: 4
    mood: 2
    textTr: "G\u0131dak! Deprem yakla\u015F\u0131yor, \xF6nce en \xF6nemli i\u015Fleri
      bitir!"
    cluck: {fileID: 0}
  - id: L1_DISASTER
    trigger: 5
    mood: 2
    textTr: "Deprem ba\u015Flad\u0131! G\xFCvenli yerde \xC7\xD6K\u2013KAPAN\u2013TUTUN!
      E\u015Fya ta\u015F\u0131ma!"
    cluck: {fileID: 0}
  - id: L1_REPORT_GOOD
    trigger: 6
    mood: 3
    textTr: "G\u0131dak! Haz\u0131rl\u0131klar\u0131m\u0131z ger\xE7ekten i\u015Fe
      yarad\u0131!"
    cluck: {fileID: 0}
  - id: L1_REPORT_BAD
    trigger: 7
    mood: 4
    textTr: "Bu defa olmad\u0131. Yeniden deneyip tehlikeli e\u015Fyalar\u0131 daha
      iyi sabitleyelim."
    cluck: {fileID: 0}

--- !u!114 &255991154
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 255991153}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7327dc6a248d5247a808ffe13c70b13, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.Levels.Level1.L1_Hud
  howToText: "\u2022 Sol fareyle bir e\u015Fyay\u0131 tut ve yaln\u0131z sa\u011Fa\u2013sola
    s\xFCr\xFCkle. Sa\u011F fare s\xFCr\xFCklemeyi iptal eder.\n\u2022 Ev sivri bir
    kayan\u0131n tepesinde durur. A\u011F\u0131r e\u015Fya kenara gittik\xE7e ev
    o y\xF6ne e\u011Filir; \xFCstteki su terazisini izle.\n\u2022 E\u015Fyay\u0131
    se\xE7ip SAB\u0130TLE (F) ile duvara ba\u011Fla (30 alt\u0131n). Sabit e\u015Fya
    depremde kaymaz.\n\u2022 MA\u011EAZA'dan deprem \xE7antas\u0131 ve yeni e\u015Fya
    al. \xC7anta olmadan deprem ba\u015Flat\u0131lamaz.\n\u2022 Haz\u0131r olunca
    AFETE HAZIRIM (Bo\u015Fluk). 3-2-1 sonra deprem ba\u015Flar.\n\u2022 Fare tekeri
    yak\u0131nla\u015Ft\u0131r\u0131r, orta fare kayd\u0131r\u0131r, Home kadraj\u0131
    s\u0131f\u0131rlar. ESC duraklat\u0131r.\n\nGER\xC7EK HAYATTA: Oyundaki e\u015Fya
    ta\u015F\u0131ma g\xFCc\xFC fantastiktir. Ger\xE7ek depremde e\u015Fya ta\u015F\u0131may\u0131n;
    a\u011F\u0131r e\u015Fyalar\u0131 \xF6nceden duvara sabitleyin ve deprem an\u0131nda
    \xC7\xD6K \u2013 KAPAN \u2013 TUTUN."
  game: {fileID: 439849233}
  cameraController: {fileID: 1297112130}
  levelTitle: "SEV\u0130YE 01 \xB7 \u0130LK SARSINTI"
  radioLine: "RADYO S\u0130VR\u0130TEPE \u2014 Bu gece sars\u0131nt\u0131 bekleniyor.
    Haz\u0131rlan!"
  safetyLine: "Ger\xE7ek depremde e\u015Fya ta\u015F\u0131may\u0131n. \xC7\xF6k \u2013
    Kapan \u2013 Tutun."
  safeAngle: 7
  warningAngle: 16
  gaugeRangeDegrees: 30
  countdownSeconds: 3
  riskWarningAngle: 18

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90fbf078177c3854ab9674f09fb42a16, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.UI.Menu.MenuFlowController
  pages:
  - id: 0
    page: {fileID: 845010204}
  - id: 1
    page: {fileID: 1477609382}
  - id: 2
    page: {fileID: 1613971403}
  - id: 3
    page: {fileID: 1441467096}
  - id: 4
    page: {fileID: 615295997}
  - id: 5
    page: {fileID: 2089637146}
  - id: 6
    page: {fileID: 1390631805}
  confirm: {fileID: 1461598719}
  menuAudio: {fileID: 171957312}
  wilson: {fileID: 875849856}
  loading: {fileID: 1441467096}
  levels:
  - {fileID: 11400000, guid: 2390c775423d69b4d9f6901cf13c47b6, type: 2}
  - {fileID: 11400000, guid: ac4150c61ac305d449bb478d5ec672fb, type: 2}
  - {fileID: 11400000, guid: 30653e884d16cbb498aac97b2fb97e4a, type: 2}
  - {fileID: 11400000, guid: 42b57c08c3ea1434d9495a8e6336ba12, type: 2}
  - {fileID: 11400000, guid: c1c70b6da6f4649459a144b433229017, type: 2}
  chapters:
  - subtitle: "\u0130lk Sars\u0131nt\u0131"
    ribbonColor: {r: 0.7058824, g: 0.4117647, b: 0.18039216, a: 1}
    thumbnailTint: {r: 1, g: 1, b: 1, a: 1}
    overlayTint: {r: 1, g: 0.6, b: 0.2, a: 0.12}
    disasterIcon: {fileID: 21300000, guid: 998571e4abb8edb48be4f61707008f4a, type: 3}
    selectLine: "Deprem b\xF6l\xFCm\xFCnde evimizi sars\u0131nt\u0131ya kar\u015F\u0131
      birlikte haz\u0131rlayaca\u011F\u0131z!"
    briefingLine: "G\u0131dak! Bu ev biraz sallanabilir. \xD6nce a\u011F\u0131r e\u015Fyalar\u0131
      g\xFCvenli h\xE2le getirelim!"
    safetyNote: "Deprem s\u0131ras\u0131nda \xC7\xF6k\u2013Kapan\u2013Tutun. E\u015Fya
      ta\u015F\u0131maya \xE7al\u0131\u015Fma."
    taskIcons:
    - {fileID: 21300000, guid: 7405d9839ab0bdf479408849ca0542e5, type: 3}
    - {fileID: 21300000, guid: 39ca206e0b9782d4da618ad5c895c7cd, type: 3}
    - {fileID: 21300000, guid: 9c9a54e0c24ba1742a018953a88880ba, type: 3}
    - {fileID: 21300000, guid: 9b91b516d0a4ceb44ba175312af1fd9a, type: 3}
    showDropCoverHold: 1
  - subtitle: "R\xFCzg\xE2ra Kar\u015F\u0131"
    ribbonColor: {r: 0.18431373, g: 0.37254903, b: 0.65882355, a: 1}
    thumbnailTint: {r: 0.5568628, g: 0.6509804, b: 0.8392157, a: 1}
    overlayTint: {r: 0.1, g: 0.2, b: 0.5, a: 0.38}
    disasterIcon: {fileID: 21300000, guid: 13eceaef5a47f754da4c450d21530a44, type: 3}
    selectLine: "F\u0131rt\u0131na geliyor! \xC7at\u0131y\u0131, pencereleri ve balkonu
      birlikte g\xFC\xE7lendirelim."
    briefingLine: "G\u0131dak! R\xFCzg\xE2r geliyor. \xC7at\u0131y\u0131, pencereleri
      ve balkonu kontrol edelim!"
    safetyNote: "\u015Eiddetli r\xFCzg\xE2rda pencerelerden uzak, g\xFCvenli bir
      i\xE7 alanda kal."
    taskIcons:
    - {fileID: 21300000, guid: 13eceaef5a47f754da4c450d21530a44, type: 3}
    - {fileID: 21300000, guid: 9fdb916cf8193924db0b0f70bd48b2cf, type: 3}
    - {fileID: 21300000, guid: 7846e2cf2594ba34d8d8fcaf01755485, type: 3}
    showDropCoverHold: 0
  - subtitle: "Duman\u0131n Ard\u0131nda"
    ribbonColor: {r: 0.7529412, g: 0.22352941, b: 0.16862746, a: 1}
    thumbnailTint: {r: 1, g: 0.7058824, b: 0.54901963, a: 1}
    overlayTint: {r: 0.95, g: 0.3, b: 0.05, a: 0.32}
    disasterIcon: {fileID: 21300000, guid: a1ba5f5556dc7c94ca5865b88829c7cb, type: 3}
    selectLine: "Yang\u0131n \xE7\u0131kmadan \xF6nlem alal\u0131m: alarm, s\xF6nd\xFCr\xFCc\xFC
      ve a\xE7\u0131k bir ka\xE7\u0131\u015F yolu!"
    briefingLine: "G\u0131dak! Yang\u0131n \xE7\u0131kmadan \xF6nlem alal\u0131m.
      Alarm\u0131, t\xFCp\xFC ve ka\xE7\u0131\u015F yolunu haz\u0131rlayal\u0131m!"
    safetyNote: "Yo\u011Fun dumanda yang\u0131nla m\xFCcadeleye giri\u015Fme; g\xFCvenli
      tahliye \xF6nceliklidir."
    taskIcons:
    - {fileID: 21300000, guid: 553d40bdd30c90d4f9b1cf8b8a566a60, type: 3}
    - {fileID: 21300000, guid: 979122ffc00f5744cbf15daa5b7caf6e, type: 3}
    - {fileID: 21300000, guid: a1ba5f5556dc7c94ca5865b88829c7cb, type: 3}
    - {fileID: 21300000, guid: 6a3499119f8b8b742b7bff27841cf97a, type: 3}
    showDropCoverHold: 0
  - subtitle: "G\xF6ky\xFCz\xFCn\xFCn \xD6fkesi"
    ribbonColor: {r: 0.41568628, g: 0.24705882, b: 0.627451, a: 1}
    thumbnailTint: {r: 0.65882355, g: 0.5647059, b: 0.84705883, a: 1}
    overlayTint: {r: 0.35, g: 0.12, b: 0.6, a: 0.4}
    disasterIcon: {fileID: 21300000, guid: 42d9db4bf70febf488966bff20db3d2c, type: 3}
    selectLine: "G\xF6k g\xFCrl\xFCyor! Elektrik g\xFCvenli\u011Fini f\u0131rt\u0131nadan
      \xF6nce tamamlayal\u0131m."
    briefingLine: "G\u0131dak! G\xF6k g\xFCr\xFClt\xFCs\xFC yakla\u015Fmadan elektrik
      g\xFCvenli\u011Fi haz\u0131rl\u0131klar\u0131n\u0131 tamamlayal\u0131m!"
    safetyNote: "G\xF6k g\xFCrlerken d\u0131\u015Far\u0131 \xE7\u0131kma ve elektrikli
      cihazlar\u0131n fi\u015Fini \xE7ekme."
    taskIcons:
    - {fileID: 21300000, guid: c2a7849063f739a499107a557f749268, type: 3}
    - {fileID: 21300000, guid: 304962e95a0a50a4597bbe2dd6f84d8c, type: 3}
    - {fileID: 21300000, guid: 42d9db4bf70febf488966bff20db3d2c, type: 3}
    showDropCoverHold: 0
  - subtitle: "Palas Pand\u0131ras"
    ribbonColor: {r: 0.12156863, g: 0.43529412, b: 0.54509807, a: 1}
    thumbnailTint: {r: 0.5176471, g: 0.7058824, b: 0.8, a: 1}
    overlayTint: {r: 0.05, g: 0.3, b: 0.5, a: 0.38}
    disasterIcon: {fileID: 21300000, guid: 3cde0e10b324306479b3d9fd8b771603, type: 3}
    selectLine: "Son b\xF6l\xFCm! Suyun eve girmemesi i\xE7in birlikte haz\u0131rlanal\u0131m."
    briefingLine: "G\u0131dak! \xC7ok ya\u011Fmur ya\u011Facak! Suyun eve girmemesi
      i\xE7in haz\u0131rlanal\u0131m!"
    safetyNote: "Su bask\u0131n\u0131nda elektrikli cihazlardan uzak dur; g\xFCvenli
      yere ge\xE7."
    taskIcons:
    - {fileID: 21300000, guid: f23481d406239974693a46674152540f, type: 3}
    - {fileID: 21300000, guid: 2b6f8aa0eeb92ac449a8351b386e503f, type: 3}
    showDropCoverHold: 0
  menuMusic: {fileID: 8300000, guid: 6dd2552a962251c4cb261b7455d40bda, type: 3}

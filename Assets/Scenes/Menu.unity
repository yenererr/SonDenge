  m_Script: {fileID: 11500000, guid: 84dee518baa34874e928e05c4f42a2f4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.UI.Menu.HowToPlayView
  firstSelected: {fileID: 357831564}
  duration: 0.24
  animatedRoot: {fileID: 0}
  staggered: []
  staggerDelay: 0.06
  tabs:
  - {fileID: 887465370}
  - {fileID: 261391596}
  - {fileID: 1836893777}
  - {fileID: 1574549267}
  - {fileID: 1444784892}
  - {fileID: 1675640145}
  heading: {fileID: 294849145}
  leftColumn: {fileID: 1187319093}
  rightColumn: {fileID: 1030385140}
  scroll: {fileID: 1387847353}
  rowPrefab: {fileID: 2730550698587768364, guid: 643c3abcec842cc4a8396edde507d0d4, type: 3}
  wilsonText: {fileID: 1300809954}
  backButton: {fileID: 357831564}
  sections:
  - tabTitle: Temel Kontroller
    tabIcon: {fileID: 21300000, guid: d82430752c89e8e41b6e667fd93f5134, type: 3}
    heading: Temel Kontroller
    wilsonLine: "Kontrolleri \xF6\u011Frenirsen her \u015Fey daha kolay olacak!"
    items:
    - key: A / D
      icon: {fileID: 0}
      text: "Sola / sa\u011Fa y\xFCr\xFC"
    - key: W / S
      icon: {fileID: 0}
      text: "Merdivenden \xE7\u0131k / in"
    - key: E
      icon: {fileID: 0}
      text: "K\xFC\xE7\xFCk e\u015Fyay\u0131 al / b\u0131rak, g\xF6rev noktas\u0131n\u0131
        kullan"
    - key: F
      icon: {fileID: 0}
      text: "Se\xE7ili b\xFCy\xFCk e\u015Fyay\u0131 sabitle"
    - key: 
      icon: {fileID: 21300000, guid: 8c44e87d927e3bc48ae77bb5c9105647, type: 3}
      text: "Sol t\u0131k: e\u015Fyay\u0131 se\xE7 ve s\xFCr\xFCkle \xB7 Sa\u011F
        t\u0131k: iptal"
    - key: "BO\u015ELUK"
      icon: {fileID: 0}
      text: "Afete haz\u0131r\u0131m \xB7 depremde \xC7\xF6k\u2013Kapan\u2013Tutun"
    - key: 
      icon: {fileID: 21300000, guid: 8c44e87d927e3bc48ae77bb5c9105647, type: 3}
      text: "Tekerlek: yak\u0131nla\u015F / uzakla\u015F \xB7 Home: kadraj\u0131
        s\u0131f\u0131rla"
    - key: ESC
      icon: {fileID: 0}
      text: Oyunu duraklat
  - tabTitle: "G\xF6revler"
    tabIcon: {fileID: 21300000, guid: 0e20e1cf59b498940834b73137b0b7eb, type: 3}
    heading: "G\xF6revler"
    wilsonLine: "Her g\xF6rev evimizi biraz daha g\xFCvenli yapar!"
    items:
    - key: 
      icon: {fileID: 21300000, guid: 5c4205d8913f05949af7bf9a972130d3, type: 3}
      text: "Her b\xF6l\xFCm Wilson'\u0131n brifingiyle ba\u015Flar; haz\u0131rl\u0131k
        s\xFCresi sen ba\u015Flay\u0131nca akar."
    - key: 
      icon: {fileID: 21300000, guid: 0e20e1cf59b498940834b73137b0b7eb, type: 3}
      text: "G\xF6rev listesi ekran\u0131n k\xF6\u015Fesinde; tamamlanan g\xF6rev
        i\u015Faretlenir."
    - key: 
      icon: {fileID: 21300000, guid: 7846e2cf2594ba34d8d8fcaf01755485, type: 3}
      text: "Ta\u015F\u0131nacak e\u015Fyay\u0131 E ile al, parlayan hedef alana
        b\u0131rak."
    - key: 
      icon: {fileID: 21300000, guid: 07660122268e8814c88019464846aaf0, type: 3}
      text: "Sabitleme g\xF6revinde e\u015Fyay\u0131 se\xE7 ve F'ye bas."
    - key: 
      icon: {fileID: 21300000, guid: ffeec99a4d2835b459cc46ec374a06f3, type: 3}
      text: "Tak\u0131l\u0131rsan Wilson'dan ipucu iste."
    - key: 
      icon: {fileID: 21300000, guid: d037e1aeb19322e4dae84aacdedd1966, type: 3}
      text: "S\xFCre biterse afet eksik g\xF6revlerle ba\u015Flar."
  - tabTitle: Denge Sistemi
    tabIcon: {fileID: 21300000, guid: 9b91b516d0a4ceb44ba175312af1fd9a, type: 3}
    heading: Denge Sistemi
    wilsonLine: "A\u011F\u0131rl\u0131klar\u0131 dengeli da\u011F\u0131t\u0131rsan
      ev sapasa\u011Flam kal\u0131r!"
    items:
    - key: 
      icon: {fileID: 21300000, guid: 998571e4abb8edb48be4f61707008f4a, type: 3}
      text: "Ev sivri bir kayan\u0131n tepesinde durur."
    - key: 
      icon: {fileID: 21300000, guid: 9b91b516d0a4ceb44ba175312af1fd9a, type: 3}
      text: "Her e\u015Fyan\u0131n etkisi: k\xFCtle \xD7 merkeze yatay uzakl\u0131k."
    - key: 
      icon: {fileID: 21300000, guid: 30fa8e5d40f80f240a624c4cc9ad9cfa, type: 3}
      text: "A\u011F\u0131rl\u0131k bir yana y\u0131\u011F\u0131l\u0131rsa ev o y\xF6ne
        e\u011Filir."
    - key: 
      icon: {fileID: 21300000, guid: f324af4a8d838f444920191e96d441be, type: 3}
      text: "26\xB0'yi yakla\u015F\u0131k 1 saniye a\u015Farsa ev devrilir."
    - key: 
      icon: {fileID: 21300000, guid: 5c4205d8913f05949af7bf9a972130d3, type: 3}
      text: "Bu denge kural\u0131 oyuna \xF6zg\xFC ve kurgusald\u0131r; ger\xE7ek
        evler b\xF6yle \xE7al\u0131\u015Fmaz."
  - tabTitle: "Afet A\u015Famalar\u0131"
    tabIcon: {fileID: 21300000, guid: 998571e4abb8edb48be4f61707008f4a, type: 3}
    heading: "Afet A\u015Famalar\u0131"
    wilsonLine: "Haz\u0131rl\u0131k, afet, rapor... sonra yeni b\xF6l\xFCm!"
    items:
    - key: 1
      icon: {fileID: 0}
      text: "Haz\u0131rl\u0131k: g\xF6revleri tamamla, e\u015Fyalar\u0131 yerle\u015Ftir."
    - key: 2
      icon: {fileID: 0}
      text: "Afet: 12\u201330 saniye s\xFCrer, do\u011Fru davran\u0131\u015F\u0131
        se\xE7."
    - key: 3
      icon: {fileID: 0}
      text: "Afet Raporu: puan, y\u0131ld\u0131z ve \xF6\u011Frendiklerin."
    - key: 
      icon: {fileID: 21300000, guid: c2a7849063f739a499107a557f749268, type: 3}
      text: "Haz\u0131rl\u0131k \xF6nlemleri afetteki hasar\u0131 azalt\u0131r."
    - key: 
      icon: {fileID: 21300000, guid: d037e1aeb19322e4dae84aacdedd1966, type: 3}
      text: "S\xFCre bitince afet eksik g\xF6revlerle ba\u015Flar."
  - tabTitle: Puanlama
    tabIcon: {fileID: 21300000, guid: c2477add94c3ed14b9d161b568d7351b, type: 3}
    heading: Puanlama
    wilsonLine: "\xDC\xE7 y\u0131ld\u0131z i\xE7in kritik g\xF6revleri unutma!"
    items:
    - key: 35
      icon: {fileID: 0}
      text: "Haz\u0131rl\u0131k g\xF6revleri"
    - key: 35
      icon: {fileID: 0}
      text: "Afette do\u011Fru davran\u0131\u015F"
    - key: 20
      icon: {fileID: 0}
      text: Ev dengesi
    - key: 10
      icon: {fileID: 0}
      text: "E\u015Fyalar\u0131 koruma"
    - key: 
      icon: {fileID: 21300000, guid: 6326c9a2d1cb2bc4bba2803cb2aaa55b, type: 3}
      text: "70+ puan 2 y\u0131ld\u0131z \xB7 90+ ve b\xFCt\xFCn kritik g\xF6revler
        3 y\u0131ld\u0131z"
    - key: 
      icon: {fileID: 21300000, guid: c2477add94c3ed14b9d161b568d7351b, type: 3}
      text: "Ev devrilirse 0 y\u0131ld\u0131z; en iyi y\u0131ld\u0131z\u0131n kaydedilir."
  - tabTitle: "\u0130pu\xE7lar\u0131"
    tabIcon: {fileID: 21300000, guid: ffeec99a4d2835b459cc46ec374a06f3, type: 3}
    heading: "\u0130pu\xE7lar\u0131"
    wilsonLine: "Bunlar ger\xE7ek hayatta da i\u015Fe yarar!"
    items:
    - key: 
      icon: {fileID: 21300000, guid: 07660122268e8814c88019464846aaf0, type: 3}
      text: "A\u011F\u0131r mobilyay\u0131 \xF6nceden duvara sabitle."
    - key: 
      icon: {fileID: 21300000, guid: 0531bf89970275b4286a81bc301099df, type: 3}
      text: "Depremde ko\u015Fma; \xC7\xF6k\u2013Kapan\u2013Tutun."
    - key: 
      icon: {fileID: 21300000, guid: 6a3499119f8b8b742b7bff27841cf97a, type: 3}
      text: "Yang\u0131nda ka\xE7\u0131\u015F yolunu a\xE7\u0131k tut, duman\u0131n
        alt\u0131nda kal."
    - key: 
      icon: {fileID: 21300000, guid: 42d9db4bf70febf488966bff20db3d2c, type: 3}
      text: "Y\u0131ld\u0131r\u0131m tehlikesinde i\xE7eride kal."
    - key: 
      icon: {fileID: 21300000, guid: 3cde0e10b324306479b3d9fd8b771603, type: 3}
      text: "Su bask\u0131n\u0131nda elektrikli cihazlardan uzak dur."
    - key: 
      icon: {fileID: 21300000, guid: 5c4205d8913f05949af7bf9a972130d3, type: 3}
      text: "Oyundaki e\u015Fya ta\u015F\u0131ma g\xFCc\xFC kurgudur; ger\xE7ek afette
        e\u015Fya ta\u015F\u0131ma."

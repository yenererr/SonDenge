MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1231834247}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c8b3c4a6bb0b18448bea3b5110afa96, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jam.UI.Menu.LoadingView
  firstSelected: {fileID: 0}
  duration: 0.24
  animatedRoot: {fileID: 0}
  staggered: []
  staggerDelay: 0.06
  fill: {fileID: 1994209668}
  statusText: {fileID: 1208715592}
  percentText: {fileID: 1994209667}
  tipTitle: {fileID: 463144631}
  tipText: {fileID: 463144630}
  tipSeconds: 4
  minVisibleSeconds: 0.6
  tips:
  - realLife: 0
    text: "A\u011F\u0131r e\u015Fyalar\u0131 evin ortas\u0131na yak\u0131n yerle\u015Ftirmek
      evin dengesini korur."
  - realLife: 0
    text: "B\xFCy\xFCk e\u015Fyay\u0131 se\xE7ip F ile sabitle; sabit e\u015Fya afette
      kaymaz."
  - realLife: 0
    text: "E ile k\xFC\xE7\xFCk e\u015Fyay\u0131 al, hedef alan\u0131n yan\u0131nda
      yeniden E ile b\u0131rak."
  - realLife: 0
    text: "Denge g\xF6stergesi k\u0131rm\u0131z\u0131ya yakla\u015F\u0131rsa a\u011F\u0131rl\u0131\u011F\u0131
      kar\u015F\u0131 tarafa ta\u015F\u0131."
  - realLife: 0
    text: "Ev 26\xB0'yi yakla\u015F\u0131k 1 saniye a\u015Farsa devrilir. E\u011Fimi
      izle!"
  - realLife: 0
    text: "G\xF6revler bitince BO\u015ELUK ile afete erken ba\u015Flayabilirsin."
  - realLife: 0
    text: "Depremde BO\u015ELUK ile \xC7\xF6k\u2013Kapan\u2013Tutun yap; do\u011Fru
      davran\u0131\u015F puan kazand\u0131r\u0131r."
  - realLife: 0
    text: "Fare tekeriyle yak\u0131nla\u015F, Home tu\u015Fuyla kadraj\u0131 s\u0131f\u0131rla."
  - realLife: 1
    text: "Dolaplar\u0131 ve kitapl\u0131klar\u0131 \xF6nceden duvara sabitle."
  - realLife: 1
    text: "Deprem an\u0131nda ko\u015Fma; \xC7\xF6k\u2013Kapan\u2013Tutun."
  - realLife: 1
    text: "Deprem \xE7antan\u0131 evdeki herkesin bildi\u011Fi bir yerde tut."
  - realLife: 1
    text: "Yang\u0131nda duman\u0131n alt\u0131nda kal ve g\xFCvenle tahliye ol."
  - realLife: 1
    text: "Duman alarm\u0131n\u0131 d\xFCzenli olarak test et."
  - realLife: 1
    text: "G\xF6k g\xFCrlerken d\u0131\u015Far\u0131 \xE7\u0131kma; elektrikli cihazlar\u0131n
      fi\u015Fini \xF6nceden \xE7ek."
  - realLife: 1
    text: "Su basan alanda elektri\u011Fe dokunma, y\xFCksek ve g\xFCvenli bir yere
      ge\xE7."
  - realLife: 1
    text: "F\u0131rt\u0131nada pencerelerden uzak, i\xE7 bir odada kal."
